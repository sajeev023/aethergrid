# AetherGrid Configuration Example

DATABASE_URL="file:./data/aethergrid.db"
AETHER_JWT_SECRET="replace-with-secure-32-byte-hex"
AETHER_STORAGE_SECRET="replace-with-secure-32-byte-hex"

# Dedicated Storage Node Path (Non-C drive recommended)
AETHERGRID_NODE_STORAGE_PATH="D:\\AetherGridStorage"
AETHERGRID_NODE_ID="AETHERGRID-NODE-001"
AETHERGRID_NODE_CAPACITY_GB=50
AETHERGRID_RESERVED_FREE_SPACE_GB=10
AETHER_NODE_TOKEN="replace-with-node-secret-token"

# Beta & Safety
BETA_SINGLE_NODE_MODE=true
STOP_NEW_UPLOADS=false
MAINTENANCE_MODE=false
MAX_FILE_SIZE_BYTES=104857600

PAYMENT_WEBHOOK_SECRET="replace-with-webhook-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
